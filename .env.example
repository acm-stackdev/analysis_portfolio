# Notion integration token (shared across all databases below)
NOTION_SECRET=

# Career/experience database — read by actions/experience.ts
# Required properties: Company (title), Job Title (rich_text),
# Description (rich_text), Start Date (date), End Date (date)
# Bullet details come from the page body (bulleted_list_item blocks)
NOTION_DATABASE_EXP_ID=

# Contact form inbox — written by actions/contact.ts
# Required properties: Name (title), Email Address (email), Subject (rich_text)
NOTION_DATABASE_ID=

# File assets database — read by app/resume/page.tsx
# Requires a row with Name title exactly "Main CV" and the PDF in a
# Documents files property
NOTION_DATABASE_ASSETS_ID=
